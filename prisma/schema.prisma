// Quell — data model
// Single-SKU OTC storefront. Quell is an over-the-counter lubricating eye drop
// sold under the OTC drug monograph, so there is no prescription gating here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  /// Set the first time the customer checks out. Links subscription renewal
  /// webhooks back to an account, and opens the Stripe billing portal.
  stripeCustomerId String? @unique

  orders              Order[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token that was emailed. The raw token is never stored, so
  /// a leaked database can't be used to reset anyone's password.
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// Trademarked tagline, e.g. "Quiet the Storm"
  tagline     String
  description String
  /// Net contents as printed on the carton, e.g. ".33 fl oz (10 mL)"
  sizeLabel   String
  priceCents  Int
  imageUrl    String?
  active      Boolean @default(true)

  /// Units on hand. Checked before checkout and decremented when payment lands.
  stockQuantity Int @default(0)
  /// At or below this, the storefront shows a low-stock nudge.
  lowStockAt    Int @default(10)

  orderItems OrderItem[]
}

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// pending -> paid (Stripe webhook) -> shipped | cancelled
  status String @default("pending")

  /// "one_time" or "subscription". Renewal orders are created by the invoice
  /// webhook and are always "subscription".
  purchaseMode         String  @default("one_time")
  stripeSubscriptionId String?
  /// Stripe invoice id for renewals, so a replayed event can't duplicate an order.
  stripeInvoiceId      String? @unique

  /// Goods only, before shipping.
  subtotalCents Int @default(0)
  /// 0 when the order qualifies for free shipping.
  shippingCents Int @default(0)
  /// Grand total actually charged: subtotal + shipping.
  totalCents    Int

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  /// Captured from Stripe Checkout on payment, so we know where to ship.
  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity       Int
  unitPriceCents Int
}
