// Quell — data model
// Single-SKU OTC storefront. Quell is an over-the-counter lubricating eye drop
// sold under the OTC drug monograph, so there is no prescription gating here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  /// Gateway customer profile, set the first time the customer checks out.
  /// Deliberately gateway-neutral: this holds an Authorize.net CIM profile id
  /// today and survives a processor change without another migration.
  /// Unused until stored cards or recurring billing land.
  paymentProfileId String? @unique

  orders              Order[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token that was emailed. The raw token is never stored, so
  /// a leaked database can't be used to reset anyone's password.
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// Trademarked tagline, e.g. "Quiet the Storm"
  tagline     String
  description String
  /// Net contents as printed on the carton, e.g. ".33 fl oz (10 mL)"
  sizeLabel   String
  priceCents  Int
  imageUrl    String?
  active      Boolean @default(true)

  /// Units on hand. Checked before checkout and decremented when payment lands.
  stockQuantity Int @default(0)
  /// At or below this, the storefront shows a low-stock nudge.
  lowStockAt    Int @default(10)

  orderItems OrderItem[]
}

model Order {
  id String @id @default(cuid())

  /// Null for guest checkout. Buying does not require an account — forcing one
  /// is a well-known source of cart abandonment, and with subscriptions
  /// deferred there is nothing an account is needed for at purchase time.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Where receipts go. Always populated: the account's address for a signed-in
  /// buyer, the one typed at checkout for a guest.
  ///
  /// Deliberately stored on the order rather than read through the user, so
  /// order history survives an account email change and fulfilment has a
  /// contact address without a join. It is also the second factor for guest
  /// order lookup.
  email String

  /// Short, human-readable reference, e.g. "Q-7F3K9M2A".
  ///
  /// Load-bearing: the gateway is told this as the transaction's invoiceNumber
  /// and it is how the webhook finds its way back to this order. Authorize.net
  /// caps invoiceNumber at 20 characters, so the 25-character cuid id above
  /// cannot be used for that. Doubles as the reference on emails and packing
  /// slips.
  orderNumber String @unique

  /// pending -> paid (gateway webhook) -> shipped | cancelled
  status String @default("pending")

  /// "one_time" or "subscription". Only "one_time" is reachable today —
  /// recurring billing is deferred to a later Authorize.net ARB phase.
  purchaseMode          String  @default("one_time")
  /// Reserved for that ARB phase; nothing writes these yet.
  paymentSubscriptionId String?
  paymentInvoiceId      String? @unique

  /// Goods only, before shipping.
  subtotalCents Int @default(0)
  /// 0 when the order qualifies for free shipping.
  shippingCents Int @default(0)
  /// Grand total actually charged: subtotal + shipping.
  totalCents    Int

  /// Gateway transaction id, written when the payment webhook lands. Unique so
  /// a replayed webhook cannot pay the same order twice.
  paymentTransactionId String? @unique

  /// Set when an admin marks the order shipped. Distinct from `updatedAt`,
  /// which any edit moves — this is specifically when the parcel went out, and
  /// it is what a "where is my order" enquiry is answered from.
  shippedAt DateTime?

  /// Carrier key, e.g. "usps". Kept as a plain string rather than an enum so
  /// adding a carrier is a code change, not a migration. `lib/carriers.ts`
  /// turns it into a name and a tracking URL; an unrecognised value degrades
  /// to showing the bare number rather than breaking the email.
  trackingCarrier String?
  /// As printed on the label. Shown to the customer in the shipping notice.
  trackingNumber  String?

  /// Collected by us before checkout — the hosted payment page only
  /// pre-populates an address, it does not gather one.
  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([email])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity       Int
  unitPriceCents Int
}
