# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string.
# Local:      postgresql://postgres:PASSWORD@localhost:5432/quell
# Production: use your managed Postgres URL (Neon, Supabase, RDS, ...).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quell"

# Session signing secret — use 32+ random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Payments (Authorize.net, the gateway in front of StaxPay) ----------
# All three come from the Merchant Interface under
# Account > Settings > Security Settings > General Security Settings >
# API Credentials and Keys.
#
# Use a SANDBOX account for development: https://developer.authorize.net/
# Leave these empty and checkout returns a clean 503 instead of failing.
AUTHORIZENET_API_LOGIN_ID=""
AUTHORIZENET_TRANSACTION_KEY=""

# Required for webhooks. Shown as 128 hex characters; paste it exactly as
# given — the app decodes it to bytes before hashing.
AUTHORIZENET_SIGNATURE_KEY=""

# "sandbox" (default) or "production". Controls which gateway host is used,
# so the live endpoint is never reached by accident.
AUTHORIZENET_ENVIRONMENT="sandbox"

# Base URL used for payment redirects, emails, sitemap and OG tags.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Search indexing. Must be exactly "true" to allow it; anything else,
# including unset, disallows everything. A *.vercel.app or localhost origin is
# never indexed regardless. Turn on only when the store can actually sell.
ALLOW_INDEXING=""

# --- Email (transactional) ---------------------------------------------
# From https://resend.com/api-keys. Without it, emails are printed to the
# server console instead of being sent, so local dev still works.
RESEND_API_KEY=""
EMAIL_FROM="Quell <orders@yourdomain.com>"

# --- Admin --------------------------------------------------------------
# Comma-separated emails allowed into /admin/orders. Unset means nobody.
ADMIN_EMAILS=""

# Who is emailed to pack an order when payment clears. Comma separated.
# Falls back to ADMIN_EMAILS when empty, so notifications work as soon as
# email is configured.
FULFILMENT_EMAILS=""
