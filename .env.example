# Copy to .env and fill in. Never commit the real .env.

# Local SQLite database (path is relative to the project root).
DATABASE_URL="file:./prisma/dev.db"

# Session signing secret — use 32+ random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Stripe -------------------------------------------------------------
# TEST keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# Base URL used for Stripe redirects, emails, sitemap and OG tags.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (transactional) ---------------------------------------------
# From https://resend.com/api-keys. Without it, emails are printed to the
# server console instead of being sent, so local dev still works.
RESEND_API_KEY=""
EMAIL_FROM="Quell <orders@yourdomain.com>"

# --- Admin --------------------------------------------------------------
# Comma-separated emails allowed into /admin/orders. Unset means nobody.
ADMIN_EMAILS=""
